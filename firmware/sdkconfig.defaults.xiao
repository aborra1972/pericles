# XIAO ESP32-S3R8 sdkconfig defaults
# 8MB Flash + 8MB PSRAM configuration

# Flash configuration
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# The connected XIAO ESP32-S3 boots its known-good image in DIO mode.
# DIO is conservative and compatible with its verified 4-line Quad SPI flash.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM configuration (XIAO ESP32-S3R8 uses embedded Octal PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

# IRAM optimization - use ROM SPI flash implementation to free ~9KB IRAM
# Safe because AUTO_SUSPEND is already disabled (no flash cache suspend needed)
CONFIG_SPI_FLASH_ROM_IMPL=y
# Also disable the patched ROM driver (ROM_IMPL supersedes it)
# CONFIG_SPI_FLASH_ROM_DRIVER_PATCH is not set

# Move non-critical ISR/driver code out of IRAM (app uses I2C+BLE only)
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
# CONFIG_SPI_SLAVE_ISR_IN_IRAM is not set
# CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM is not set
# CONFIG_PERIPH_CTRL_FUNC_IN_IRAM is not set
# CONFIG_GDMA_CTRL_FUNC_IN_IRAM is not set
# CONFIG_ESP_SPI_BUS_LOCK_ISR_FUNCS_IN_IRAM is not set

# I2C configuration
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# BLE
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1

# WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# HTTP Client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
