# Pericles Backend — Required Environment Variables
# Copy to .env and fill in values for local development

# Server
PORT=3000
NODE_ENV=development

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Database (required for ADR-04 memory)
# DATABASE_URL=postgresql://user:pass@localhost:5432/pericles

# Device Authentication
DEVICE_TOKEN_SECRET=generate-a-random-secret-here
TOKEN_TTL_SECONDS=86400

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=info
